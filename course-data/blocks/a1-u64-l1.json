{"id":"a1-u64-l1","levelId":"a1","cefr":"A1","title":"进阶商店排队","subtitle":"说明排队和付款","theme":"shop-queue","grammarFocus":"present-simple","grammarTags":["present-simple","shopping-language"],"words":[["queue","队伍"],["cashier","收银员"],["receipt","收据"],["counter","柜台"],["cash","现金"],["wait","等待"]],"questions":[{"id":"a1-u64-l1-q1","kind":"word","prompt":"queue · 商店排队","instruction":"选择意思。","answer":"队伍","options":["队伍","收银员","收据","柜台"],"translation":"队伍","grammarTags":["present-simple"],"skillTags":["vocabulary"]},{"id":"a1-u64-l1-q2","kind":"choice","prompt":"The queue is moving quickly today.","instruction":"选择意思。","answer":"今天队伍移动得很快。","options":["今天队伍移动得很快。","今天收银员离开柜台。","今天收据放在现金旁边。","今天顾客在入口等待。"],"audio":"The queue is moving quickly today.","translation":"今天队伍移动得很快。","grammarTags":["present-simple"],"skillTags":["reading"]},{"id":"a1-u64-l1-q3","kind":"listen","prompt":"听句子，选择意思。","instruction":"听完整句子。","answer":"收银员正在扫描商品。","options":["收银员正在扫描商品。","顾客正在收起收据。","队伍正在柜台后面。","现金正在收银台下面。"],"audio":"The cashier is scanning the items.","translation":"收银员正在扫描商品。","grammarTags":["present-simple"],"skillTags":["listening"]},{"id":"a1-u64-l1-q4","kind":"order","prompt":"请在队伍末尾等待。","instruction":"组成英文句子。","answer":"Please wait at the end of the queue.","audio":"Please wait at the end of the queue.","translation":"请在队伍末尾等待。","grammarTags":["present-simple"],"skillTags":["word-order"]},{"id":"a1-u64-l1-q5","kind":"fill","prompt":"The cashier gives me a _____.","instruction":"选择名词。","answer":"receipt","options":["receipt","queue","cash","counter"],"audio":"The cashier gives me a receipt.","translation":"收银员给我一张收据。","grammarTags":["present-simple"],"skillTags":["grammar"]},{"id":"a1-u64-l1-q6","kind":"match","prompt":"配对商店排队词语。","instruction":"完成配对。","pairs":[["queue","队伍"],["cashier","收银员"],["receipt","收据"],["counter","柜台"],["cash","现金"],["wait","等待"]],"answer":"matched","translation":"队伍、收银员、收据、柜台、现金、等待","grammarTags":["present-simple"],"skillTags":["matching"]},{"id":"a1-u64-l1-q7","kind":"word","prompt":"cashier · 商店排队","instruction":"选择意思。","answer":"收银员","options":["收银员","现金","队伍","收据"],"translation":"收银员","grammarTags":["present-simple"],"skillTags":["vocabulary"]},{"id":"a1-u64-l1-q8","kind":"choice","prompt":"I pay in cash at the small counter.","instruction":"选择意思。","answer":"我在小柜台用现金付款。","options":["我在小柜台用现金付款。","我在队伍里等待收银员。","我把收据放进现金盒。","我在柜台后数商品。"],"audio":"I pay in cash at the small counter.","translation":"我在小柜台用现金付款。","grammarTags":["present-simple"],"skillTags":["reading"]},{"id":"a1-u64-l1-q9","kind":"listen","prompt":"听句子，选择意思。","instruction":"听完整句子。","answer":"请准备好准确的现金。","options":["请准备好准确的现金。","请把收据交给收银员。","请在队伍前面等待。","请把商品放在柜台。"],"audio":"Please prepare the exact cash.","translation":"请准备好准确的现金。","grammarTags":["present-simple"],"skillTags":["listening"]},{"id":"a1-u64-l1-q10","kind":"fill","prompt":"The line _____ near the door.","instruction":"选择动词。","answer":"starts","options":["starts","start","starting","started"],"audio":"The line starts near the door.","translation":"队伍从门旁开始排。","grammarTags":["present-simple"],"skillTags":["grammar"]}],"dialogue":{"id":"a1-u64-l1-dialogue","scene":"商店排队付款","characters":[{"id":"lumi","name":"Lumi"},{"id":"cashier","name":"Cashier"}],"turns":[{"speaker":"lumi","text":"Is this the queue for payment?","translation":"这是付款队伍吗？"},{"speaker":"cashier","text":"Yes, please wait behind the blue sign.","translation":"是的，请在蓝色标志后等待。"},{"speaker":"lumi","text":"I have cash and I am ready.","translation":"我有现金，已经准备好了。"}]},"sourceStatus":"hand-authored"}

{"id":"a1-u20-l1","levelId":"a1","cefr":"A1","title":"家居清洁","subtitle":"描述清洁习惯和用品","theme":"home-cleaning","grammarFocus":"present-simple","grammarTags":["present-simple","household"],"words":[["dust","灰尘"],["mop","拖地"],["soap","肥皂"],["bucket","水桶"],["clean","清洁"],["dirty","脏的"]],"questions":[{"id":"a1-u20-l1-q1","kind":"word","prompt":"dust · 家居清洁","instruction":"选择这个词的意思。","answer":"灰尘","options":["灰尘","拖地","肥皂","水桶"],"translation":"灰尘","grammarTags":["present-simple"],"skillTags":["vocabulary"]},{"id":"a1-u20-l1-q2","kind":"choice","prompt":"I clean the windows every Saturday.","instruction":"选择这句习惯表达的意思。","answer":"我每周六擦窗户。","options":["我每周六擦窗户。","我每天擦地板。","我周日洗衣服。","我周五整理厨房。"],"audio":"I clean the windows every Saturday.","translation":"我每周六擦窗户。","grammarTags":["present-simple"],"skillTags":["reading"]},{"id":"a1-u20-l1-q3","kind":"listen","prompt":"听句子，选择你听到的意思。","instruction":"先听完整句子。","answer":"地板很脏。","options":["地板很脏。","水桶是蓝色的。","肥皂在浴室里。","灰尘在窗台上。"],"audio":"The floor is very dirty.","translation":"地板很脏。","grammarTags":["present-simple"],"skillTags":["listening"]},{"id":"a1-u20-l1-q4","kind":"order","prompt":"妈妈每天拖厨房的地。","instruction":"把词块组成英文句子。","answer":"Mum mops the kitchen floor every day.","options":["Mum mops the kitchen floor every day."],"audio":"Mum mops the kitchen floor every day.","translation":"妈妈每天拖厨房的地。","grammarTags":["present-simple"],"skillTags":["word-order"]},{"id":"a1-u20-l1-q5","kind":"fill","prompt":"We use _____ to wash our hands.","instruction":"选择正确的名词。","answer":"soap","options":["soap","dust","bucket","mop"],"audio":"We use soap to wash our hands.","translation":"我们用肥皂洗手。","grammarTags":["present-simple"],"skillTags":["grammar"]},{"id":"a1-u20-l1-q6","kind":"match","prompt":"把家居清洁词语配对。","instruction":"完成全部配对。","pairs":[["dust","灰尘"],["mop","拖地"],["soap","肥皂"],["bucket","水桶"],["clean","清洁"],["dirty","脏的"]],"answer":"matched","translation":"灰尘、拖地、肥皂、水桶、清洁、脏的","grammarTags":["present-simple"],"skillTags":["matching"]},{"id":"a1-u20-l1-q7","kind":"word","prompt":"bucket · 家居清洁","instruction":"选择这个词的意思。","answer":"水桶","options":["水桶","肥皂","灰尘","抹布"],"translation":"水桶","grammarTags":["present-simple"],"skillTags":["vocabulary"]},{"id":"a1-u20-l1-q8","kind":"choice","prompt":"She wipes the table after lunch.","instruction":"选择这句习惯表达的意思。","answer":"她午饭后擦桌子。","options":["她午饭后擦桌子。","她早餐前洗地板。","她晚饭后洗窗户。","她中午整理床铺。"],"audio":"She wipes the table after lunch.","translation":"她午饭后擦桌子。","grammarTags":["present-simple"],"skillTags":["reading"]},{"id":"a1-u20-l1-q9","kind":"listen","prompt":"听句子，选择你听到的意思。","instruction":"听完再作答。","answer":"请把湿地拖干。","options":["请把湿地拖干。","请把水桶放回去。","请清除窗上的灰尘。","请把肥皂拿来。"],"audio":"Please dry the wet floor.","translation":"请把湿地拖干。","grammarTags":["present-simple"],"skillTags":["listening"]},{"id":"a1-u20-l1-q10","kind":"fill","prompt":"The bathroom becomes _____ after a shower.","instruction":"选择正确的形容词。","answer":"wet","options":["wet","dirty","clean","dry"],"audio":"The bathroom becomes wet after a shower.","translation":"洗澡后浴室会变湿。","grammarTags":["present-simple"],"skillTags":["grammar"]}],"dialogue":{"id":"a1-u20-l1-dialogue","scene":"周末打扫房间","characters":[{"id":"lumi","name":"Lumi"},{"id":"sara","name":"Sara"}],"turns":[{"speaker":"lumi","text":"Do you clean the windows on Saturday?","translation":"你周六擦窗户吗？"},{"speaker":"sara","text":"Yes, and my brother mops the floor.","translation":"是的，我哥哥拖地。"},{"speaker":"lumi","text":"I will bring soap for the bathroom.","translation":"我会给浴室带肥皂。"}],"tasks":[{"mode":"intent","prompt":"Who mops the floor?","answer":"Sara's brother","options":["Sara's brother","Lumi","The neighbor"]}]},"sourceStatus":"hand-authored"}
